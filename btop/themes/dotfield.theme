# Dotfield Obsidian Mint Theme for btop
# Void (#080B0B) · Graphite (#16201E) · Mint (#2DD4BF) · Emerald (#10B981) · Amber (#FBBF24) · Rose (#F43F5E)

# Main background, empty for terminal default
theme[main_bg]="#080B0B"

# Main text color
theme[main_fg]="#ECFDF5"

# Title color for boxes
theme[title]="#2DD4BF"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#10B981"

# Background color of selected item in processes box
theme[selected_bg]="#16201E"

# Foreground color of selected item in processes box
theme[selected_fg]="#2DD4BF"

# Color of inactive/disabled text
theme[inactive_fg]="#71827E"

# Color of text appearing on top of graphs, i.e. uptime and current process
theme[graph_text]="#ECFDF5"

# Background color of the percentage meters
theme[meter_bg]="#16201E"

# Misc colors for processes box including mini cpu graphs, details memory graph and process list divider
theme[proc_misc]="#94A3A0"

# Box outline colors
theme[cpu_box]="#23322F"
theme[mem_box]="#23322F"
theme[net_box]="#23322F"
theme[proc_box]="#23322F"

# Box divider line and small symbols
theme[div_line]="#23322F"

# Temperature graph colors (Emerald -> Amber -> Rose)
theme[temp_start]="#10B981"
theme[temp_mid]="#FBBF24"
theme[temp_end]="#F43F5E"

# CPU graph colors
theme[cpu_start]="#2DD4BF"
theme[cpu_mid]="#FBBF24"
theme[cpu_end]="#F43F5E"

# Mem/Disk free meter
theme[free_start]="#10B981"
theme[free_mid]="#2DD4BF"
theme[free_end]="#F43F5E"

# Mem/Disk cached meter
theme[cached_start]="#71827E"
theme[cached_mid]="#2DD4BF"
theme[cached_end]="#10B981"

# Mem/Disk available meter
theme[available_start]="#10B981"
theme[available_mid]="#FBBF24"
theme[available_end]="#F43F5E"

# Mem/Disk used meter
theme[used_start]="#10B981"
theme[used_mid]="#FBBF24"
theme[used_end]="#F43F5E"

# Download graph colors
theme[download_start]="#23322F"
theme[download_mid]="#10B981"
theme[download_end]="#2DD4BF"

# Upload graph colors
theme[upload_start]="#10B981"
theme[upload_mid]="#FBBF24"
theme[upload_end]="#F43F5E"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#10B981"
theme[process_mid]="#FBBF24"
theme[process_end]="#F43F5E"
