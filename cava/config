## Dotfield CAVA Configuration — Controlled Chaos
## Declarative audio visualizer configuration for modern Wayland desktops.

[general]
# Output framerate (FPS)
framerate = 60

# Automatic sensitivity adjustment (1 = enabled)
autosens = 1
sensitivity = 100

# Bar configuration: 0 = dynamic width filling terminal
bars = 0
bar_width = 2
bar_spacing = 1

# Bandwidth cutoff frequencies
lower_cutoff_freq = 50
higher_cutoff_freq = 12000

# Sleep timer in seconds when no audio detected (preserves CPU at 0 Hz)
sleep_timer = 2

[input]
# Primary Wayland/Linux audio input
method = pipewire
source = auto

[output]
# Terminal output engine
method = noncurses
orientation = bottom
channels = stereo
mono_option = average

[color]
theme = 'dotfield-live'
# Cyber Synthwave Palette Theme
background = default
foreground = '#14B9B5'

# Vertical gradient from baseline to peak
gradient = 1
gradient_color_1 = '#140E29'
gradient_color_2 = '#251B4A'
gradient_color_3 = '#9147A8'
gradient_color_4 = '#04C5F0'
gradient_color_5 = '#11AEB3'
gradient_color_6 = '#14B9B5'
gradient_color_7 = '#FF7F41'
gradient_color_8 = '#BE3F50'

[smoothing]
# Monstercat smoothing filter for fluid frequency response
monstercat = 1
waves = 0
noise_reduction = 75

[eq]
1 = 1.0 # Sub-bass
2 = 1.0 # Bass
3 = 1.0 # Midrange
4 = 1.0 # Upper-mids
5 = 1.0 # Treble
