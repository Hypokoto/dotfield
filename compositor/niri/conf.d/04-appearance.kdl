// Niri Appearance & Low-Latency Rendering
// Fluent snappy animations (200ms ease-out-cubic, zero bounce)

prefer-no-csd

animations {
    workspace-switch {
        duration-ms 200
        curve "ease-out-cubic"
    }
    horizontal-view-movement {
        duration-ms 200
        curve "ease-out-cubic"
    }
    window-open {
        duration-ms 200
        curve "ease-out-cubic"
    }
    window-close {
        duration-ms 200
        curve "ease-out-cubic"
    }
}

// Terminal Glass & Smooth Geometry (Ghostty, Foot, Kitty, Alacritty)
// Native Wayland sub-surface transparency without broken dmabuf shader overrides
window-rule {
    match app-id=r#"^(com\.mitchellh\.ghostty|floating-term|foot|kitty|Alacritty)$"#

    opacity 0.78
    geometry-corner-radius 12
    clip-to-geometry true
}
