// Niri Appearance & Low-Latency Rendering
// Fluent snappy animations (200ms ease-out-cubic, zero bounce)

prefer-no-csd

animations {
    workspace-switch {
        duration-ms 200
        curve "ease-out-cubic"
    }
    horizontal-view-movement {
        duration-ms 200
        curve "ease-out-cubic"
    }
    window-open {
        duration-ms 200
        curve "ease-out-cubic"
        custom-shader r#"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                vec2 uv = coords_geo.xy;
                vec2 center = vec2(0.5, 0.5);
                float scale = mix(0.96, 1.0, p);
                vec2 scaled_uv = (uv - center) / scale + center;
                vec3 tex_coords = niri_geo_to_tex * vec3(scaled_uv, 1.0);
                vec4 color = texture2D(niri_tex, tex_coords.st);
                float alpha = smoothstep(0.0, 0.8, p);
                return color * alpha;
            }
        "#
    }
    window-close {
        duration-ms 180
        curve "ease-out-cubic"
        custom-shader r#"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                vec2 uv = coords_geo.xy;
                vec2 center = vec2(0.5, 0.5);
                float scale = mix(1.0, 0.96, p);
                vec2 scaled_uv = (uv - center) / scale + center;
                vec3 tex_coords = niri_geo_to_tex * vec3(scaled_uv, 1.0);
                vec4 color = texture2D(niri_tex, tex_coords.st);
                float alpha = smoothstep(1.0, 0.2, p);
                return color * alpha;
            }
        "#
    }
}

// Terminal Geometry (Ghostty, Foot, Kitty, Alacritty)
// Terminals manage their own internal background opacity; window-level opacity is kept 1.0 for crisp font rendering
window-rule {
    match app-id=r#"^(com\.mitchellh\.ghostty|floating-term|foot|kitty|Alacritty)$"#

    geometry-corner-radius 12
    clip-to-geometry true
}
