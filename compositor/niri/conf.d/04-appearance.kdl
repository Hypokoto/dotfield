// Niri Appearance & Low-Latency Rendering
// Fluent snappy animations (200ms ease-out-cubic, zero bounce)

prefer-no-csd

animations {
    workspace-switch {
        duration-ms 200
        curve "ease-out-cubic"
    }
    horizontal-view-movement {
        duration-ms 200
        curve "ease-out-cubic"
    }
    window-open {
        duration-ms 200
        curve "ease-out-cubic"
    }
    window-close {
        duration-ms 200
        curve "ease-out-cubic"
    }
}

// Dual Kawase Background Blur Tuning
blur {
    passes 7
    offset 3.0
    noise 0.01
    saturation 1.2
}

// Terminal Glass Effect (Ghostty, Foot, Kitty, Alacritty)
// ponytail: minimalist pure native compositor glass with clean frosted edge
window-rule {
    match app-id=r#"^(com\.mitchellh\.ghostty|floating-term|foot|kitty|Alacritty)$"#

    opacity 0.78
    geometry-corner-radius 15
    clip-to-geometry true

    border {
        width 0
    }

    background-effect {
        blur true
        xray true
        noise 0.01
        saturation 1.2
    }
}
