// Niri Startup Processes
// Background daemons and visual engine autostart

spawn-at-startup "awww-daemon"
spawn-at-startup "sh" "-c" "\"$HOME/.config/dotfield/scripts/wallpaper.sh\""
spawn-at-startup "swayidle" "-w"
spawn-at-startup "sh" "-c" "dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP NIRI_SOCKET && systemctl --user start kanshi.service && systemctl --user start amane.service"
