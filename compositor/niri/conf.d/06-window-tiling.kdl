// Niri Window Tiling & Column Management
// Fluid scrollable tiling navigation, column stacking, and ergonomic resizing

binds {
    // Column & Window Navigation (Seamless Neovim + Niri Vi Integration)
    Mod+H     { spawn "sh" "-c" "~/.config/dotfield/scripts/niri-nav.sh left"; }
    Mod+L     { spawn "sh" "-c" "~/.config/dotfield/scripts/niri-nav.sh right"; }
    Mod+J     { spawn "sh" "-c" "~/.config/dotfield/scripts/niri-nav.sh down w"; }
    Mod+K     { spawn "sh" "-c" "~/.config/dotfield/scripts/niri-nav.sh up w"; }
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down  { reset-window-height; }
    Mod+Up    { maximize-column; }

    // Moving Columns & Windows
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+L     { move-column-right; }
    Mod+Shift+J     { move-window-down; }
    Mod+Shift+K     { move-window-up; }
    Mod+Alt+Left    { move-column-left; }
    Mod+Alt+Right   { move-column-right; }

    // Windows Snap: Consume & Expel Columns
    Mod+Shift+Left   { consume-or-expel-window-left; }
    Mod+Shift+Right  { consume-or-expel-window-right; }
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma        { consume-window-into-column; }
    Mod+Period       { expel-window-from-column; }

    // Column Sizing & Fullscreen
    Mod+R       { switch-preset-column-width; }
    Mod+Alt+R   { switch-preset-column-width-back; }
    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R       { reset-window-height; }

    Mod+F              { maximize-column; }
    Mod+M              { maximize-window-to-edges; }
    Mod+Shift+F        { maximize-window-to-edges; }
    Mod+Ctrl+Shift+F   { fullscreen-window; }
    Mod+C              { center-column; }
    Mod+Ctrl+F         { expand-column-to-available-width; }

    // Tabbed Column Mode
    Mod+T { toggle-column-tabbed-display; }

    // Fine Width Adjustments
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Workspaces Navigation (Canonical BLACKSITE Workspaces)
    Mod+1 { focus-workspace "01 DEV"; }
    Mod+2 { focus-workspace "02 SYSTEM"; }
    Mod+3 { focus-workspace "03 RESEARCH"; }
    Mod+4 { focus-workspace "04 SECURITY"; }
    Mod+5 { focus-workspace "05 SCRATCH"; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    // Move Columns to Workspaces
    Mod+Shift+1 { move-column-to-workspace "01 DEV"; }
    Mod+Shift+2 { move-column-to-workspace "02 SYSTEM"; }
    Mod+Shift+3 { move-column-to-workspace "03 RESEARCH"; }
    Mod+Shift+4 { move-column-to-workspace "04 SECURITY"; }
    Mod+Shift+5 { move-column-to-workspace "05 SCRATCH"; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
}
