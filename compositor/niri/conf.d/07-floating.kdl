// Niri Floating Windows & Multi-Window Overlapping
// Window rules for floating management and dialog routing

binds {
    // Toggle focused window between floating and tiling
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
}

// Window Rules: Floating Overrides & No Border Artifacts
window-rule {
    draw-border-with-background false
}

window-rule {
    match app-id="floating-term"
    open-floating true
    default-column-width { fixed 960; }
    default-window-height { fixed 600; }
}

window-rule {
    match app-id="pavucontrol"
    open-floating true
}

window-rule {
    match app-id="imv"
    open-floating true
}

window-rule {
    match app-id="mpv"
    open-floating true
}

window-rule {
    match app-id="file-roller"
    open-floating true
}

window-rule {
    match title="^Picture-in-Picture$"
    open-floating true
}
