// Niri Floating Windows & Multi-Window Overlapping
// Window rules for floating management, authentication, pinentry, and dialog routing

binds {
    // Toggle focused window between floating and tiling
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
}

// Window Rules: Floating Overrides & No Border Artifacts
window-rule {
    draw-border-with-background false
}

window-rule {
    match app-id=r#"^(floating-term|scratchpad-term)$"#
    open-floating true
    default-column-width { fixed 960; }
    default-window-height { fixed 600; }
}

window-rule {
    match app-id="pavucontrol"
    open-floating true
}

window-rule {
    match app-id="imv"
    open-floating true
}

window-rule {
    match app-id="mpv"
    open-floating true
}

window-rule {
    match app-id="file-roller"
    open-floating true
}

window-rule {
    match title="^Picture-in-Picture$"
    open-floating true
}

// Dialogs, Authentication, Pinentry, and File Pickers
window-rule {
    match app-id="^pinentry"
    open-floating true
}

window-rule {
    match app-id="polkit"
    open-floating true
}

window-rule {
    match app-id="org.freedesktop.impl.portal.desktop"
    open-floating true
}

window-rule {
    match app-id="zenity"
    open-floating true
}

// Smart Application Tiling Rules: Default Column Proportions
// Web browsers: Wide 60% viewport for comfortable web page rendering
window-rule {
    match app-id=r#"^(firefox|firefox-developer-edition|zen|zen-browser|chromium|google-chrome|brave-browser)$"#
    default-column-width { proportion 0.6; }
}

// Terminals and Editors: Balanced 50% split for side-by-side workflows
window-rule {
    match app-id=r#"^(ghostty|foot|footclient|kitty|Alacritty)$"#
    default-column-width { proportion 0.5; }
}

// Compact utilities & Calculators: Open floating with centered default geometries
window-rule {
    match app-id=r#"^(gnome-calculator|kcalc|galculator|org.gnome.Calculator)$"#
    open-floating true
    default-column-width { fixed 400; }
    default-window-height { fixed 500; }
}
