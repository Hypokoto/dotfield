// Niri + Miri (Modal Tiling) Layout Engine Integration
// Master-Stack tiling mode, dynamic per-workspace switching, and column overrides

binds {
    // Layout Mode Switching with Visual Feedback
    Mod+M       { spawn "sh" "-c" "~/.config/dotfield/scripts/miri-toggle.sh cycle"; }
    Mod+Shift+M { spawn "sh" "-c" "~/.config/dotfield/scripts/miri-toggle.sh master"; }
    Mod+Ctrl+M  { spawn "sh" "-c" "~/.config/dotfield/scripts/miri-toggle.sh scroll"; }

    // Column Movement Overrides (Falls back to native Niri if Miri daemon is offline)
    Mod+Shift+Left  { spawn "miri" "override" "move-column-left"; }
    Mod+Shift+Right { spawn "miri" "override" "move-column-right"; }
    Mod+Shift+Home  { spawn "miri" "override" "move-column-to-first"; }
    Mod+Shift+End   { spawn "miri" "override" "move-column-to-last"; }

    // Move column to workspace overrides
    Mod+Shift+1 { spawn "miri" "override" "move-column-to-workspace" "1"; }
    Mod+Shift+2 { spawn "miri" "override" "move-column-to-workspace" "2"; }
    Mod+Shift+3 { spawn "miri" "override" "move-column-to-workspace" "3"; }
    Mod+Shift+4 { spawn "miri" "override" "move-column-to-workspace" "4"; }
    Mod+Shift+5 { spawn "miri" "override" "move-column-to-workspace" "5"; }
    Mod+Shift+6 { spawn "miri" "override" "move-column-to-workspace" "6"; }
    Mod+Shift+7 { spawn "miri" "override" "move-column-to-workspace" "7"; }
    Mod+Shift+8 { spawn "miri" "override" "move-column-to-workspace" "8"; }
    Mod+Shift+9 { spawn "miri" "override" "move-column-to-workspace" "9"; }
}
