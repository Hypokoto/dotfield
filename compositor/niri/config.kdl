// Dotfield Niri Base Configuration (KDL)
// Controlled Chaos Theme — Void Black · Crimson · Industrial Amber · Steel

input {
    keyboard {
        xkb {
            layout "us"
            options "caps:escape"
        }
        repeat-delay 200
        repeat-rate 50
    }
    touchpad {
        tap
        natural-scroll
        dwt
    }
}

output "eDP-1" {
    scale 1.0
}

layout {
    gaps 8
    center-focused-column "never"
    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#FFB000"
        inactive-color "#34343D"
    }

    border {
        off
    }

    struts {
        left 0
        right 0
        top 0
        bottom 0
    }
}

prefer-no-csd

// Fallback Keybindings
binds {
    Mod+Return { spawn "foot"; }
    Mod+Space { spawn "fuzzel"; }
    Mod+Shift+Space { spawn "rofi" "-show" "drun"; }
    Mod+Q { close-window; }
    Mod+Shift+E { spawn "sh" "-c" "command -v wlogout >/dev/null 2>&1 && wlogout || niri msg action quit"; }

    // Column & Window Navigation
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+J     { focus-window-or-workspace-down; }
    Mod+K     { focus-window-or-workspace-up; }
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }

    // Moving Columns & Windows
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+L     { move-column-right; }
    Mod+Shift+J     { move-window-down; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }

    // Sizing & Fullscreen
    Mod+R { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }

    // Workspaces
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // Media & Hardware Volume/Brightness Controls (OSD Integrated)
    XF86AudioRaiseVolume allow-when-locked=true { spawn "sh" "-c" "~/.config/dotfield/scripts/osd.sh volume_up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "sh" "-c" "~/.config/dotfield/scripts/osd.sh volume_down"; }
    XF86AudioMute        allow-when-locked=true { spawn "sh" "-c" "~/.config/dotfield/scripts/osd.sh volume_mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "sh" "-c" "~/.config/dotfield/scripts/osd.sh mic_mute"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "sh" "-c" "~/.config/dotfield/scripts/osd.sh brightness_up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "sh" "-c" "~/.config/dotfield/scripts/osd.sh brightness_down"; }
    XF86AudioPlay        allow-when-locked=true { spawn "sh" "-c" "~/.config/dotfield/scripts/osd.sh media_play_pause"; }
    XF86AudioNext        allow-when-locked=true { spawn "sh" "-c" "~/.config/dotfield/scripts/osd.sh media_next"; }
    XF86AudioPrev        allow-when-locked=true { spawn "sh" "-c" "~/.config/dotfield/scripts/osd.sh media_prev"; }

    // System Utilities & Dotfield Tools
    Mod+Slash { spawn "dotfield-gui" "--hud"; }
    Mod+P { spawn "dotfield-gui" "--switcher"; }
    Mod+Escape { spawn "sh" "-c" "~/.config/dotfield/scripts/lock.sh"; }
    Print { spawn "sh" "-c" "~/.config/dotfield/scripts/screenshot.sh --full"; }
    Shift+Print { spawn "sh" "-c" "~/.config/dotfield/scripts/screenshot.sh --area"; }
    Mod+Shift+S { spawn "sh" "-c" "~/.config/dotfield/scripts/screenshot.sh --area"; }
}

// Window Rules (Floating & Ergonomics)
window-rule {
    match app-id="dotfield-gui"
    open-floating true
    default-column-width { fixed 780; }
}

window-rule {
    match app-id="pavucontrol"
    open-floating true
}

window-rule {
    match app-id="imv"
    open-floating true
}

window-rule {
    match app-id="mpv"
    open-floating true
}

window-rule {
    match app-id="file-roller"
    open-floating true
}

// Modular Drop-ins (Dotfield Managed)
include "config.kdl.d/00-generated-bindings.kdl"
