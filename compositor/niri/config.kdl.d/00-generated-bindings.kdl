// Dotfield Generated Niri Keybindings Fragment
// Target: ~/.config/niri/config.kdl.d/00-generated-bindings.kdl
// This file is atomically compiled by Dotfield. Manual edits will be flagged as drift.

binds {
    Mod+Return { spawn "foot"; }
    Mod+Space { spawn "fuzzel"; }
    Mod+Shift+Space { spawn "rofi" "-show" "drun"; }
    Mod+Q { close-window; }
    Mod+Shift+F { fullscreen-window; }

    // Phase 4 Utilities: Screenshots and Lockscreen
    Print { spawn "sh" "-c" "~/.config/dotfield/scripts/screenshot.sh --area"; }
    Shift+Print { spawn "sh" "-c" "~/.config/dotfield/scripts/screenshot.sh --full"; }
    Mod+Escape { spawn "swaylock" "-f"; }
}
