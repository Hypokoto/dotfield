# Dotfield Sway Base Configuration
# Controlled Chaos Theme — Void Black · Crimson · Industrial Amber · Steel

### Modifiers
set $mod Mod4
set $alt Mod1

### Default Applications (Fallbacks)
set $term foot
set $menu fuzzel
set $menu_full rofi -show drun

### Output & Wallpaper
output * max_render_time 1
output * adaptive_sync on
exec_always ~/.config/dotfield/scripts/wallpaper.sh
exec mako

### Window Geometry & Borders
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders none
gaps inner 8
gaps outer 6

### Colors (PALETTE.md Controlled Chaos)
# class                 border  bground text    indicator child_border
client.focused          #FFB000 #1C1C23 #E8E6E3 #FFB000   #FFB000
client.focused_inactive #34343D #121216 #A1A1AA #34343D   #34343D
client.unfocused        #34343D #121216 #8B949E #34343D   #34343D
client.urgent           #E63946 #9D0208 #FFFFFF #E63946   #E63946
client.placeholder      #1C1C23 #0A0A0C #E8E6E3 #1C1C23   #1C1C23

### Input Devices
input "type:keyboard" {
    xkb_layout "us"
    xkb_options "caps:escape"
    repeat_delay 200
    repeat_rate 50
}

input "type:touchpad" {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
}

### Fallback Keybindings (Active when no Dotfield override is present)
bindsym $mod+Return exec $term
bindsym $mod+space exec $menu
bindsym $mod+Shift+space exec $menu_full
bindsym $mod+q kill
bindsym $mod+Shift+r reload
bindsym $mod+Shift+e exec "command -v wlogout >/dev/null 2>&1 && wlogout || swaynag -t warning -m 'Exit Sway?' -B 'Yes, exit' 'swaymsg exit'"

### Navigation & Focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

### Window Movement
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

### Layout & Tiling Controls
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen toggle
bindsym $mod+t floating toggle

### Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

### Hardware & Media Controls (OSD Integrated)
bindsym --locked XF86AudioRaiseVolume exec ~/.config/dotfield/scripts/osd.sh volume_up
bindsym --locked XF86AudioLowerVolume exec ~/.config/dotfield/scripts/osd.sh volume_down
bindsym --locked XF86AudioMute exec ~/.config/dotfield/scripts/osd.sh volume_mute
bindsym --locked XF86AudioMicMute exec ~/.config/dotfield/scripts/osd.sh mic_mute
bindsym --locked XF86MonBrightnessUp exec ~/.config/dotfield/scripts/osd.sh brightness_up
bindsym --locked XF86MonBrightnessDown exec ~/.config/dotfield/scripts/osd.sh brightness_down
bindsym --locked XF86AudioPlay exec ~/.config/dotfield/scripts/osd.sh media_play_pause
bindsym --locked XF86AudioNext exec ~/.config/dotfield/scripts/osd.sh media_next
bindsym --locked XF86AudioPrev exec ~/.config/dotfield/scripts/osd.sh media_prev

### System Utilities & Dotfield Tools
bindsym $mod+slash exec dotfield-gui --hud
bindsym $mod+p exec dotfield-gui --switcher
bindsym $mod+Escape exec ~/.config/dotfield/scripts/lock.sh
bindsym Print exec ~/.config/dotfield/scripts/screenshot.sh --full
bindsym Shift+Print exec ~/.config/dotfield/scripts/screenshot.sh --area
bindsym $mod+Shift+s exec ~/.config/dotfield/scripts/screenshot.sh --area

### Window Rules (Floating & Ergonomics)
for_window [app_id="dotfield-gui"] floating enable, border pixel 2, sticky enable
for_window [app_id="pavucontrol"] floating enable, border pixel 2
for_window [app_id="imv"] floating enable, border pixel 2
for_window [app_id="mpv"] floating enable, border pixel 2
for_window [app_id="file-roller"] floating enable, border pixel 2
for_window [app_id="swayimg"] floating enable, border pixel 2
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_type="dialog"] floating enable

### Modular Drop-ins (Dotfield Managed)
# Fragments in config.d are loaded alphabetically and take precedence over defaults
include ~/.config/sway/config.d/*.conf

### Status Bar (i3status-rust Controlled Chaos)
bar {
    position top
    status_command i3status-rs ~/.config/i3status-rust/config.toml
    font pango:JetBrainsMono Nerd Font 10
    strip_workspace_numbers yes
    colors {
        background #0A0A0C
        statusline #E8E6E3
        separator  #34343D
        focused_workspace  #FFB000 #1C1C23 #FFB000
        active_workspace   #34343D #121216 #E8E6E3
        inactive_workspace #121216 #0A0A0C #8B949E
        urgent_workspace   #E63946 #9D0208 #FFFFFF
    }
}
