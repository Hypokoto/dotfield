export global Palette {
    // Controlled Chaos Core Colors (PALETTE.md)
    out property <color> void: #0A0A0C;
    out property <color> obsidian: #121216;
    out property <color> graphite: #1C1C23;
    out property <color> iron: #34343D;
    out property <color> bone: #E8E6E3;
    out property <color> bone-muted: #A1A1AA;
    out property <color> ash: #A1A1AA;
    out property <color> amber: #FFB000;
    out property <color> pale-amber: #FFD166;
    out property <color> crimson: #E63946;
    out property <color> blood-red: #9D0208;
    out property <color> steel: #8B949E;
    out property <color> success-green: #7BC47F;

    // Typography Scale
    out property <length> font-xs: 11px;
    out property <length> font-sm: 12px;
    out property <length> font-base: 13px;
    out property <length> font-md: 14px;
    out property <length> font-lg: 16px;
    out property <length> font-title: 18px;

    // Spacing Rhythm
    out property <length> space-xs: 4px;
    out property <length> space-sm: 8px;
    out property <length> space-md: 12px;
    out property <length> space-lg: 16px;
    out property <length> space-xl: 20px;
    out property <length> space-xxl: 24px;

    // Corner Radii
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 6px;
    out property <length> radius-lg: 8px;
    out property <length> radius-pill: 9999px;
}
