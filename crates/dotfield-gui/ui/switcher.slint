import { Palette } from "palette.slint";
import { ScrollView } from "std-widgets.slint";

export struct ProfileCardData {
    name: string,
    description: string,
    compositor: string,
    apps: string,
    security: string,
    active: bool,
}

export component ProfileSwitcher inherits Window {
    title: "Dotfield Profile Switcher";
    width: 780px;
    height: 540px;
    background: Palette.void;

    in property <[ProfileCardData]> profiles: [];
    in property <string> status-message: "Select a profile to switch";
    callback apply-profile(string);
    callback close-clicked();

    forward-focus: key-handler;

    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-clicked();
                return accept;
            }
            if (event.text == "1" && root.profiles.length > 0) {
                root.apply-profile(root.profiles[0].name);
                return accept;
            }
            if (event.text == "2" && root.profiles.length > 1) {
                root.apply-profile(root.profiles[1].name);
                return accept;
            }
            if (event.text == "3" && root.profiles.length > 2) {
                root.apply-profile(root.profiles[2].name);
                return accept;
            }
            if (event.text == "4" && root.profiles.length > 3) {
                root.apply-profile(root.profiles[3].name);
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: Palette.space-xl;
            spacing: Palette.space-lg;

            // Header
            HorizontalLayout {
                alignment: space-between;
                VerticalLayout {
                    spacing: Palette.space-xs;
                    Text {
                        text: "DOTFIELD // PROFILE SWITCHER";
                        font-size: Palette.font-title;
                        font-weight: 700;
                        color: Palette.amber;
                    }
                    Text {
                        text: "Declarative Linux Ricing & Generational Swapper";
                        font-size: Palette.font-sm;
                        color: Palette.ash;
                    }
                }

                close-btn := Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: Palette.radius-sm;
                    background: close-touch.has-hover ? Palette.iron : Palette.graphite;
                    border-width: 1px;
                    border-color: close-touch.has-hover ? Palette.pale-amber : Palette.iron;

                    Text {
                        text: "✕";
                        font-size: 13px;
                        font-weight: 600;
                        color: close-touch.has-hover ? Palette.amber : Palette.bone;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close-touch := TouchArea {
                        clicked => {
                            root.close-clicked();
                        }
                    }
                }
            }

            // Cards List
            ScrollView {
                VerticalLayout {
                    spacing: Palette.space-md;
                    for p[idx] in root.profiles: card := Rectangle {
                        height: 116px;
                        background: p.active ? Palette.graphite : (card-touch.has-hover ? #181820 : Palette.obsidian);
                        border-radius: Palette.radius-lg;
                        border-width: p.active ? 2px : 1px;
                        border-color: p.active ? Palette.amber : (card-touch.has-hover ? Palette.pale-amber : Palette.iron);

                        card-touch := TouchArea {
                            clicked => {
                                if (!p.active) {
                                    root.apply-profile(p.name);
                                }
                            }
                        }

                        VerticalLayout {
                            padding: Palette.space-md;
                            spacing: Palette.space-sm;

                            // Top row: Hotkey Badge, Title, Active Badge, Apply Button
                            HorizontalLayout {
                                alignment: space-between;
                                HorizontalLayout {
                                    spacing: Palette.space-sm;

                                    // Numeric Hotkey Chip
                                    Rectangle {
                                        width: 22px;
                                        height: 22px;
                                        border-radius: Palette.radius-sm;
                                        background: p.active ? Palette.amber : Palette.graphite;
                                        border-width: 1px;
                                        border-color: p.active ? Palette.amber : Palette.iron;

                                        Text {
                                            text: (idx + 1);
                                            font-size: Palette.font-xs;
                                            font-weight: 700;
                                            color: p.active ? Palette.void : Palette.bone;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Text {
                                        text: p.name;
                                        font-size: Palette.font-lg;
                                        font-weight: 700;
                                        color: p.active ? Palette.amber : Palette.bone;
                                        vertical-alignment: center;
                                    }

                                    if (p.active): Rectangle {
                                        background: Palette.amber;
                                        border-radius: Palette.radius-sm;
                                        height: 20px;
                                        HorizontalLayout {
                                            padding-left: Palette.space-sm;
                                            padding-right: Palette.space-sm;
                                            Text {
                                                text: "ACTIVE";
                                                font-size: Palette.font-xs;
                                                font-weight: 700;
                                                color: Palette.void;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                if (!p.active): apply-btn := FocusScope {
                                    width: 96px;
                                    height: 28px;
                                    accessible-role: button;
                                    accessible-label: p.name;
                                    accessible-action-default => {
                                        root.apply-profile(p.name);
                                    }
                                    key-pressed(event) => {
                                        if (event.text == Key.Return || event.text == " ") {
                                            root.apply-profile(p.name);
                                            return accept;
                                        }
                                        return reject;
                                    }

                                    Rectangle {
                                        background: apply-touch.has-hover ? Palette.iron : (apply-btn.has-focus ? Palette.iron : Palette.graphite);
                                        border-radius: Palette.radius-sm;
                                        border-width: 1px;
                                        border-color: apply-touch.has-hover ? Palette.amber : (apply-btn.has-focus ? Palette.amber : Palette.iron);

                                        HorizontalLayout {
                                            alignment: center;
                                            Text {
                                                text: "Apply";
                                                font-size: Palette.font-sm;
                                                font-weight: 600;
                                                color: apply-touch.has-hover ? Palette.amber : Palette.pale-amber;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        apply-touch := TouchArea {
                                            clicked => {
                                                apply-btn.focus();
                                                root.apply-profile(p.name);
                                            }
                                        }
                                    }
                                }
                            }

                            // Middle row: Description
                            Text {
                                text: p.description;
                                font-size: Palette.font-sm;
                                color: Palette.ash;
                            }

                            // Bottom row: Structured Metadata Chips
                            HorizontalLayout {
                                spacing: Palette.space-sm;

                                // Compositor Chip
                                Rectangle {
                                    background: Palette.void;
                                    border-radius: Palette.radius-sm;
                                    border-width: 1px;
                                    border-color: Palette.iron;
                                    height: 22px;
                                    HorizontalLayout {
                                        padding-left: Palette.space-sm;
                                        padding-right: Palette.space-sm;
                                        spacing: Palette.space-xs;
                                        Text {
                                            text: "Compositor:";
                                            font-size: Palette.font-xs;
                                            color: Palette.ash;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: p.compositor;
                                            font-size: Palette.font-xs;
                                            font-weight: 600;
                                            color: Palette.bone;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Apps Chip
                                Rectangle {
                                    background: Palette.void;
                                    border-radius: Palette.radius-sm;
                                    border-width: 1px;
                                    border-color: Palette.iron;
                                    height: 22px;
                                    HorizontalLayout {
                                        padding-left: Palette.space-sm;
                                        padding-right: Palette.space-sm;
                                        spacing: Palette.space-xs;
                                        Text {
                                            text: "Apps:";
                                            font-size: Palette.font-xs;
                                            color: Palette.ash;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: p.apps;
                                            font-size: Palette.font-xs;
                                            font-weight: 600;
                                            color: Palette.bone;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Security Chip
                                Rectangle {
                                    background: Palette.void;
                                    border-radius: Palette.radius-sm;
                                    border-width: 1px;
                                    border-color: p.security == "Hardening declared (not enforced)" ? Palette.crimson : Palette.iron;
                                    height: 22px;
                                    HorizontalLayout {
                                        padding-left: Palette.space-sm;
                                        padding-right: Palette.space-sm;
                                        spacing: Palette.space-xs;
                                        Text {
                                            text: "Security:";
                                            font-size: Palette.font-xs;
                                            color: Palette.ash;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: p.security;
                                            font-size: Palette.font-xs;
                                            font-weight: 600;
                                            color: p.security == "Hardening declared (not enforced)" ? Palette.crimson : (p.security == "none" ? Palette.ash : Palette.success-green);
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Footer / Status Bar
            Rectangle {
                height: 36px;
                background: Palette.obsidian;
                border-radius: Palette.radius-md;
                border-width: 1px;
                border-color: Palette.iron;

                HorizontalLayout {
                    padding-left: Palette.space-md;
                    padding-right: Palette.space-md;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: Palette.space-sm;
                        Text {
                            text: "●";
                            font-size: 10px;
                            color: Palette.amber;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.status-message;
                            font-size: Palette.font-sm;
                            color: Palette.bone;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "[1..4] Quick Apply  •  [Esc] Dismiss";
                        font-size: Palette.font-xs;
                        color: Palette.steel;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
