{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/logo.txt",
        "color": {
            "1": "magenta"
        },
        "padding": {
            "top": 1,
            "right": 3
        }
    },
    "display": {
        "separator": "  󰄾  ",
        "color": {
            "keys": "magenta",
            "title": "cyan"
        },
        "key": {
            "width": 14
        }
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": "󰣇 OS",
            "keyColor": "cyan"
        },
        {
            "type": "host",
            "key": "󰌢 Host",
            "keyColor": "cyan"
        },
        {
            "type": "kernel",
            "key": "󰒋 Kernel",
            "keyColor": "cyan"
        },
        {
            "type": "uptime",
            "key": "󱑂 Uptime",
            "keyColor": "cyan"
        },
        {
            "type": "packages",
            "key": "󰏖 Packages",
            "keyColor": "cyan"
        },
        {
            "type": "shell",
            "key": "󰞷 Shell",
            "keyColor": "yellow"
        },
        {
            "type": "wm",
            "key": "󱂬 Desktop",
            "keyColor": "yellow"
        },
        {
            "type": "terminal",
            "key": " Terminal",
            "keyColor": "yellow"
        },
        {
            "type": "display",
            "key": "󰍹 Display",
            "keyColor": "yellow"
        },
        {
            "type": "cpu",
            "key": "󰻠 CPU",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "󰢮 GPU",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "󰍛 Memory",
            "keyColor": "green"
        },
        {
            "type": "swap",
            "key": "󰓡 Swap",
            "keyColor": "green"
        },
        {
            "type": "disk",
            "key": "󰋊 Disk (/)",
            "keyColor": "green"
        },
        {
            "type": "battery",
            "key": "󰂁 Battery",
            "keyColor": "red"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
