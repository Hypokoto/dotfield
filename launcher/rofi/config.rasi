/**
 * Dotfield Rofi Configuration
 * Controlled Chaos Theme — Void Black · Crimson · Industrial Amber · Steel
 **/

configuration {
    modi: "drun,run,window,filebrowser";
    font: "JetBrainsMono Nerd Font 11";
    show-icons: true;
    terminal: "foot";
    drun-display-format: "{name}";
    disable-history: false;
    sidebar-mode: true;
    matching: "fuzzy";
    sorting-method: "fzf";
    threads: 0;

    // Vi-Mode & Ergonomic Keybindings
    kb-row-up: "Up,Control+k,Control+p";
    kb-row-down: "Down,Control+j,Control+n";
    kb-accept-entry: "Return,KP_Enter,Control+m";
    kb-mode-next: "Shift+Right,Control+Tab";
    kb-mode-previous: "Shift+Left,Control+Shift+Tab";
    kb-remove-to-eol: "Control+Shift+e";
    kb-cancel: "Escape,Control+c,Control+bracketleft";
}

@theme "/dev/null"

* {
    bg-col: #121216;
    bg-col-light: #1C1C23;
    border-col: #FFB000;
    selected-col: #1C1C23;
    amber: #FFB000;
    crimson: #E63946;
    fg-col: #E8E6E3;
    fg-muted: #A1A1AA;
}

element-text, element-icon, mode-switcher {
    background-color: inherit;
    text-color: inherit;
}

window {
    width: 640px;
    height: 420px;
    border: 2px;
    border-color: @border-col;
    border-radius: 8px;
    background-color: @bg-col;
}

mainbox {
    background-color: @bg-col;
    padding: 16px;
    children: [inputbar, listview, mode-switcher];
}

inputbar {
    children: [prompt, entry];
    background-color: @bg-col;
    border-radius: 6px;
    padding: 0px 0px 8px 0px;
}

prompt {
    background-color: @amber;
    padding: 6px 14px;
    text-color: #0A0A0C;
    border-radius: 4px;
    font-weight: bold;
}

entry {
    padding: 6px 12px;
    text-color: @fg-col;
    background-color: @bg-col-light;
    border-radius: 4px;
    margin: 0px 0px 0px 8px;
    placeholder: "Search applications, commands, or open windows...";
    placeholder-color: @fg-muted;
}

listview {
    border: 0px;
    padding: 8px 0px;
    margin: 8px 0px;
    columns: 2;
    lines: 6;
    background-color: @bg-col;
}

element {
    padding: 8px 12px;
    background-color: @bg-col;
    text-color: @fg-col;
    border-radius: 6px;
}

element-icon {
    size: 22px;
    margin: 0px 10px 0px 0px;
}

element selected {
    background-color: @selected-col;
    text-color: @amber;
    border: 1px;
    border-color: @amber;
}

mode-switcher {
    spacing: 8px;
    padding: 8px 0px 0px 0px;
}

button {
    padding: 8px 12px;
    background-color: @bg-col-light;
    text-color: @fg-muted;
    border-radius: 4px;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}

button selected {
    background-color: @bg-col;
    text-color: @amber;
    border: 1px;
    border-color: @amber;
}

message {
    background-color: @bg-col-light;
    margin: 4px;
    padding: 6px;
    border-radius: 4px;
}

textbox {
    padding: 6px;
    text-color: @fg-col;
    background-color: @bg-col-light;
}
