/**
 * Dotfield Rofi Configuration
 * Controlled Chaos Theme — Void Black · Crimson · Industrial Amber · Steel
 **/

configuration {
    modi: "drun,run,window";
    font: "JetBrainsMono Nerd Font 11";
    show-icons: true;
    terminal: "foot";
    drun-display-format: "{name}";
    disable-history: false;
    sidebar-mode: false;
    matching: "fuzzy";
    sorting-method: "fzf";
    threads: 0;
}

@theme "/dev/null"

* {
    bg-col:  #121216;
    bg-col-light: #1C1C23;
    border-col: #FFB000;
    selected-col: #1C1C23;
    amber: #FFB000;
    crimson: #E63946;
    fg-col: #E8E6E3;
    fg-muted: #A1A1AA;
}

element-text, element-icon , mode-switcher {
    background-color: inherit;
    text-color:       inherit;
}

window {
    width: 600px;
    height: 380px;
    border: 2px;
    border-color: @border-col;
    border-radius: 8px;
    background-color: @bg-col;
}

mainbox {
    background-color: @bg-col;
}

inputbar {
    children: [prompt,entry];
    background-color: @bg-col;
    border-radius: 5px;
    padding: 2px;
}

prompt {
    background-color: @amber;
    padding: 6px 12px;
    text-color: #0A0A0C;
    border-radius: 3px;
    margin: 20px 0px 0px 20px;
}

textbox-prompt-colon {
    expand: false;
    str: ":";
}

entry {
    padding: 6px;
    margin: 20px 0px 0px 10px;
    text-color: @fg-col;
    background-color: @bg-col;
    placeholder: "Search applications...";
    placeholder-color: @fg-muted;
}

listview {
    border: 0px 0px 0px;
    padding: 6px 0px 0px;
    margin: 10px 20px 0px 20px;
    columns: 2;
    lines: 6;
    background-color: @bg-col;
}

element {
    padding: 6px 10px;
    background-color: @bg-col;
    text-color: @fg-col;
    border-radius: 4px;
}

element-icon {
    size: 20px;
    margin: 0px 8px 0px 0px;
}

element selected {
    background-color:  @selected-col;
    text-color: @amber;
    border: 1px;
    border-color: @amber;
}

mode-switcher {
    spacing: 0;
}

button {
    padding: 8px;
    background-color: @bg-col-light;
    text-color: @fg-muted;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}

button selected {
    background-color: @bg-col;
    text-color: @amber;
}

message {
    background-color: @bg-col-light;
    margin: 2px;
    padding: 2px;
    border-radius: 5px;
}

textbox {
    padding: 6px;
    margin: 20px 0px 0px 20px;
    text-color: @fg-col;
    background-color: @bg-col-light;
}
