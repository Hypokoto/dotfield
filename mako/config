# Mako notification daemon configuration managed by Dotfield
# Obsidian Mint — Tactical Interface
# Canonical definition: PALETTE.md

# Typography & Geometry
font=JetBrainsMono Nerd Font 10
width=380
height=180
margin=16
padding=12,16
border-size=1
border-radius=4
layer=overlay
max-visible=5
default-timeout=6000
group-by=app-name,summary,urgency

# Format & Markup
format=<b>%s</b>\n%b
markup=1
actions=1

# Icons
icons=1
max-icon-size=48
icon-location=left

# Default Normal Urgency (Cyber Synthwave Accent & Hairline Border)
background-color=#000000
text-color=#14B9B5
border-color=#04C5F0
progress-color=source #04C5F0

# Low Urgency (Subdued Violet & Teal)
[urgency=low]
background-color=#140E29
text-color=#11AEB3
border-color=#251B4A
progress-color=source #11AEB3
default-timeout=4000

# Critical Urgency (Red Accent & Zero-Timeout)
[urgency=critical]
background-color=#140E29
text-color=#FFFFFF
border-color=#BE3F50
progress-color=source #BE3F50
default-timeout=0
ignore-timeout=1

# OSD & Ephemeral Notifications (No Notification History Pollution)
[category=volume]
history=0
default-timeout=1200
group-by=category

[category=brightness]
history=0
default-timeout=1200
group-by=category

[category=osd]
history=0
default-timeout=1200
group-by=category

# Dotfield Engine Notifications
[app-name=dotfield]
border-color=#04C5F0

# Screenshot Notifications
[app-name=Screenshot]
border-color=#04C5F0

# Battery Alerts (Cyber Synthwave Low & Critical Warnings)
[app-name=battery-alert]
border-color=#04C5F0
default-timeout=8000

[category=battery-low]
border-color=#FF7F41
background-color=#140E29
text-color=#14B9B5
default-timeout=10000

[category=battery-critical]
border-color=#BE3F50
background-color=#251B4A
text-color=#FFFFFF
default-timeout=0
ignore-timeout=1

# Do-Not-Disturb Mode
[mode=do-not-disturb]
invisible=1

# Locked Mode (Privacy Mode: suppress notification popups while screen is locked)
[mode=locked]
invisible=1
