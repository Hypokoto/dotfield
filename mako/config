# Mako notification daemon configuration managed by Dotfield
# Obsidian Mint — Tactical Interface
# Canonical definition: PALETTE.md

# Typography & Geometry
font=JetBrainsMono Nerd Font 10
width=380
height=180
margin=16
padding=12,16
border-size=1
border-radius=4
layer=overlay
max-visible=5
default-timeout=6000
group-by=app-name,summary,urgency

# Format & Markup
format=<b>%s</b>\n%b
markup=1
actions=1

# Icons
icons=1
max-icon-size=48
icon-location=left

# Default Normal Urgency (Obsidian Mint Accent & Hairline Border)
background-color=#080B0B
text-color=#ECFDF5
border-color=#2DD4BF
progress-color=source #2DD4BF

# Low Urgency (Subdued Steel & Iron)
[urgency=low]
background-color=#0E1413
text-color=#94A3A0
border-color=#23322F
progress-color=source #71827E
default-timeout=4000

# Critical Urgency (Rose Critical & Zero-Timeout)
[urgency=critical]
background-color=#0E1413
text-color=#ECFDF5
border-color=#F43F5E
progress-color=source #F43F5E
default-timeout=0
ignore-timeout=1

# OSD & Ephemeral Notifications (No Notification History Pollution)
[category=volume]
history=0
default-timeout=1200
group-by=category

[category=brightness]
history=0
default-timeout=1200
group-by=category

[category=osd]
history=0
default-timeout=1200
group-by=category

# Dotfield Engine Notifications
[app-name=dotfield]
border-color=#2DD4BF

# Screenshot Notifications
[app-name=Screenshot]
border-color=#2DD4BF

# Battery Alerts (Obsidian Mint Low & Critical Warnings)
[app-name=battery-alert]
border-color=#2DD4BF
default-timeout=8000

[category=battery-low]
border-color=#FBBF24
background-color=#0E1413
text-color=#ECFDF5
default-timeout=10000

[category=battery-critical]
border-color=#F43F5E
background-color=#16201E
text-color=#ECFDF5
default-timeout=0
ignore-timeout=1

# Do-Not-Disturb Mode
[mode=do-not-disturb]
invisible=1

# Locked Mode (Privacy Mode: suppress notification popups while screen is locked)
[mode=locked]
invisible=1
