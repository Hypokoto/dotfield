# Swayidle configuration managed by Dotfield
# Graceful idle timeouts, screen blanking, and lock triggers

# Lock screen before suspend/sleep
before-sleep 'swaylock -f'

# Turn off display after 300s (5m)
timeout 300 'swaymsg "output * power off" 2>/dev/null || niri msg action power-off-monitors 2>/dev/null' \
        resume 'swaymsg "output * power on" 2>/dev/null || true'

# Lock screen after 600s (10m)
timeout 600 'swaylock -f'
