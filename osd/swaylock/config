# Swaylock configuration managed by Dotfield
# Cyber Synthwave — Tactical Interface
# Void #000000 · Surface #140E29 · Overlay #251B4A · Cyan-Teal #14B9B5 · Blue #04C5F0 · Red #BE3F50

daemonize
ignore-empty-password
show-failed-attempts
show-keyboard-layout
indicator-caps-lock
indicator-idle-visible

# Typography & Indicator Geometry
font=JetBrainsMono Nerd Font
font-size=13
indicator-radius=110
indicator-thickness=8

# Base Canvas (Default Void Black)
color=000000
scaling=fill

# Indicator Center Disc (Semi-translucent Surface & Overlay)
inside-color=140E29ee
inside-clear-color=251B4Aee
inside-ver-color=251B4Aee
inside-wrong-color=251B4Aee
inside-caps-lock-color=251B4Aee

# Indicator Ring Outer Boundary (Hairline Overlay & Neon Blue)
ring-color=251B4A
ring-clear-color=04C5F0
ring-ver-color=04C5F0
ring-wrong-color=BE3F50
ring-caps-lock-color=BE3F50

# Inner Separator Line
line-color=00000000
line-clear-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
line-caps-lock-color=00000000
separator-color=00000000

# Keypress & Backspace Glowing Arc Highlights
key-hl-color=04C5F0
bs-hl-color=BE3F50
caps-lock-key-hl-color=04C5F0
caps-lock-bs-hl-color=BE3F50

# Center Text & Status Labels
text-color=14B9B5
text-clear-color=04C5F0
text-ver-color=04C5F0
text-wrong-color=BE3F50
text-caps-lock-color=BE3F50

# Keyboard Layout Badge Box
layout-bg-color=251B4Aee
