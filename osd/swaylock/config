# Swaylock configuration managed by Dotfield
# Obsidian Mint — Tactical Interface
# Void #080B0B · Obsidian #0E1413 · Graphite #16201E · Iron #23322F · Minted White #ECFDF5 · Mint #2DD4BF · Rose #F43F5E

daemonize
ignore-empty-password
show-failed-attempts
show-keyboard-layout
indicator-caps-lock
indicator-idle-visible

# Typography & Indicator Geometry
font=JetBrainsMono Nerd Font
font-size=13
indicator-radius=110
indicator-thickness=8

# Base Canvas (Default Void Black)
color=080B0B
scaling=fill

# Indicator Center Disc (Semi-translucent Obsidian & Graphite)
inside-color=0E1413ee
inside-clear-color=16201Eee
inside-ver-color=16201Eee
inside-wrong-color=23322Fee
inside-caps-lock-color=23322Fee

# Indicator Ring Outer Boundary (Hairline Iron & Tactical Mint)
ring-color=23322F
ring-clear-color=2DD4BF
ring-ver-color=2DD4BF
ring-wrong-color=F43F5E
ring-caps-lock-color=F43F5E

# Inner Separator Line
line-color=00000000
line-clear-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
line-caps-lock-color=00000000
separator-color=00000000

# Keypress & Backspace Glowing Arc Highlights
key-hl-color=2DD4BF
bs-hl-color=F43F5E
caps-lock-key-hl-color=2DD4BF
caps-lock-bs-hl-color=F43F5E

# Center Text & Status Labels
text-color=ECFDF5
text-clear-color=2DD4BF
text-ver-color=2DD4BF
text-wrong-color=F43F5E
text-caps-lock-color=F43F5E

# Keyboard Layout Badge Box
layout-bg-color=16201Eee
layout-border-color=23322F
layout-text-color=ECFDF5
