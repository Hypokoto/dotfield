# Swaylock configuration managed by Dotfield
# BLACKSITE Industrial Noir — Tactical Interface
# Void #08080A · Obsidian #111216 · Graphite #181920 · Iron #282A36 · Bone #E6E6EB · Amber #FFB000 · Crimson #E63946

daemonize
ignore-empty-password
show-failed-attempts
show-keyboard-layout
indicator-caps-lock
indicator-idle-visible

# Typography & Indicator Geometry
font=JetBrainsMono Nerd Font
font-size=13
indicator-radius=110
indicator-thickness=8

# Base Canvas (Default Void Black)
color=08080A
scaling=fill

# Indicator Center Disc (Semi-translucent Obsidian & Graphite)
inside-color=111216ee
inside-clear-color=181920ee
inside-ver-color=181920ee
inside-wrong-color=282A36ee
inside-caps-lock-color=282A36ee

# Indicator Ring Outer Boundary (Hairline Iron & Tactical Amber)
ring-color=282A36
ring-clear-color=FFB000
ring-ver-color=FFB000
ring-wrong-color=E63946
ring-caps-lock-color=E63946

# Inner Separator Line
line-color=00000000
line-clear-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
line-caps-lock-color=00000000
separator-color=00000000

# Keypress & Backspace Glowing Arc Highlights
key-hl-color=FFB000
bs-hl-color=E63946
caps-lock-key-hl-color=FFB000
caps-lock-bs-hl-color=E63946

# Center Text & Status Labels
text-color=E6E6EB
text-clear-color=FFB000
text-ver-color=FFB000
text-wrong-color=E63946
text-caps-lock-color=E63946

# Keyboard Layout Badge Box
layout-bg-color=181920ee
layout-border-color=282A36
layout-text-color=E6E6EB
