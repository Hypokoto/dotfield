# AppArmor profile abstraction for Dotfield background processes
# Managed by Dotfield

abi <abi/3.0>,
include <tunables/global>

profile dotfield-daemon flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>
  include <abstractions/nameservice>

  # Helper binaries execute within this profile; they cannot read arbitrary host binaries.
  /usr/bin/* ix,
  /usr/sbin/* ix,
  /bin/* ix,

  # Deny read access to critical secrets and keys
  deny @{HOME}/.ssh/** rwklx,
  deny @{HOME}/.gnupg/** rwklx,
  deny @{HOME}/.aws/** rwklx,
  deny @{HOME}/.pki/** rwklx,
  deny @{HOME}/.local/share/keyrings/** rwklx,
  deny @{HOME}/.config/keepassxc/** rwklx,
  deny /etc/shadow r,
  deny /etc/gshadow r,
  deny /etc/{shadow-,gshadow-} r,

  # Allow reading/writing to dotfield state and cache
  owner @{HOME}/.dotfield/** rwk,
  owner @{HOME}/.config/dotfield/** rwk,
  owner @{HOME}/.config/{sway/config.d,niri/config.kdl.d,fuzzel,foot,mako}/ rw,
  owner @{HOME}/.config/{sway/config.d,niri/config.kdl.d,fuzzel,foot,mako}/** rwl,
  @{PROC}/ r,
  @{PROC}/*/{stat,cmdline,comm,status} r,
  owner @{run}/user/*/{sway-ipc.*,niri.*,wayland-*,mako*} rw,
  owner /tmp/dotfield-* rwk,

  # Allow monitoring hardware power status
  /sys/class/power_supply/ r,
  /sys/class/power_supply/** r,
  /sys/devices/**/power_supply/** r,
}
