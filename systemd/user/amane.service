[Unit]
Description=Amane Wayland Desktop Shell Daemon for Niri
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.local/bin/amane --foreground
Restart=always
RestartSec=1
Slice=session.slice

[Install]
WantedBy=graphical-session.target
