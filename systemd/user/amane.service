[Unit]
Description=Amane Wayland Desktop Shell Daemon for Niri
ConditionEnvironment=XDG_CURRENT_DESKTOP=niri
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.local/bin/amane --foreground
Restart=on-failure
RestartSec=1
Slice=session.slice

[Install]
WantedBy=graphical-session.target
