# Ghostty Configuration — Managed by Dotfield
# Controlled Chaos Theme — Void Black · Crimson · Industrial Amber · Steel
# Architecture: Modern Native Wayland/GTK4 · Pure Native Search · Alt-based Navigation

# --- Theme & Colors ---
theme = dotfield-theme
background-opacity = 0.80
background-opacity-cells = true
background-blur = false

# --- Typography & Font Rendering ---
font-family = JetBrainsMono Nerd Font
font-style = Regular
font-style-bold = Bold
font-style-italic = Italic
font-style-bold-italic = Bold Italic
font-synthetic-style = bold,italic,bold-italic
font-thicken = true
font-size = 11
font-feature = calt
font-feature = liga

# --- Window Geometry & Presentation ---
window-padding-x = 12
window-padding-y = 12
window-padding-balance = true
window-theme = ghostty
window-titlebar-background = 000000
window-titlebar-foreground = 14B9B5
window-decoration = false
window-show-tab-bar = always
gtk-wide-tabs = false
gtk-toolbar-style = flat
gtk-titlebar = false
gtk-tabs-location = top

# --- Cursor & Bell ---
cursor-style = block
cursor-style-blink = false

# --- Scrollback & Pure Native Search ---
scrollback-limit-lines = 100000
scrollback-limit-bytes = 104857600
mouse-hide-while-typing = true
mouse-scroll-multiplier = precision:1,discrete:3
keybind = shift+page_up=scroll_page_up
keybind = shift+page_down=scroll_page_down
keybind = shift+home=scroll_to_top
keybind = shift+end=scroll_to_bottom

# --- Clipboard Integration ---
clipboard-read = allow
clipboard-write = allow
clipboard-trim-trailing-spaces = true
copy-on-select = clipboard

# --- Shell Integration ---
# Disabled to protect agent harnesses (Claude Code, Hermes, Codex, OpenCode) from OSC 133 escape sequence corruption
shell-integration = none

# --- Performance & Process Lifecycle ---
auto-update = off
gtk-single-instance = detect

# --- Keybindings: Configuration & System ---
keybind = ctrl+shift+comma=reload_config

# --- Keybindings: Clipboard & Font Management ---
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl++=increase_font_size:1
keybind = ctrl+==increase_font_size:1
keybind = ctrl+-=decrease_font_size:1
keybind = ctrl+0=reset_font_size

# --- Keybindings: Native Tabs (Alt-based) ---
keybind = alt+t=new_tab
keybind = alt+w=close_tab:this
keybind = alt+]=next_tab
keybind = alt+[=previous_tab
keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5

# --- Native Splits & Independent Zoom (Ghostty-native) ---
split-preserve-zoom = navigation
keybind = alt+enter=new_split:right
keybind = alt+shift+enter=new_split:down
keybind = alt+h=goto_split:left
keybind = alt+l=goto_split:right
keybind = alt+k=goto_split:up
keybind = alt+j=goto_split:down
keybind = alt+o=goto_split:next
keybind = alt+z=toggle_split_zoom
keybind = ctrl+shift+enter=toggle_split_zoom
keybind = alt+==equalize_splits

# --- Keybindings: Adjust Split Boundaries (like tmux prefix + arrows) ---
keybind = alt+left=resize_split:left,30
keybind = alt+right=resize_split:right,30
keybind = alt+up=resize_split:up,30
keybind = alt+down=resize_split:down,30
keybind = alt+shift+h=resize_split:left,30
keybind = alt+shift+l=resize_split:right,30
keybind = alt+shift+k=resize_split:up,30
keybind = alt+shift+j=resize_split:down,30

# --- Keybindings: Pure Native Search ---
keybind = alt+s=start_search
keybind = alt+f=start_search
keybind = ctrl+shift+f=start_search
