  --headerbar-fg-color: ${DOTFIELD_FG};
  --headerbar-bg-color: ${DOTFIELD_SURFACE};
  --headerbar-backdrop-color: ${DOTFIELD_BG};
  --overview-fg-color: ${DOTFIELD_FG};
  --overview-bg-color: ${DOTFIELD_BG};
  --popover-fg-color: ${DOTFIELD_FG};
  --popover-bg-color: ${DOTFIELD_OVERLAY};
  --window-fg-color: ${DOTFIELD_FG};
  --window-bg-color: ${DOTFIELD_BG};
  --accent-bg-color: ${DOTFIELD_ACCENT};
  --accent-fg-color: ${DOTFIELD_ON_ACCENT};
  --accent-color: ${DOTFIELD_ACCENT};
}

windowhandle, headerbar, tabbar {
  background-color: ${DOTFIELD_SURFACE};
  color: ${DOTFIELD_FG};
}

windowhandle:backdrop, headerbar:backdrop, tabbar:backdrop {
  background-color: ${DOTFIELD_BG};
}

tabbar tab {
  color: ${DOTFIELD_FG_MUTED};
}

tabbar tab:checked {
  background-color: ${DOTFIELD_OVERLAY};
  color: ${DOTFIELD_FG};
}

.window .split paned > separator {
