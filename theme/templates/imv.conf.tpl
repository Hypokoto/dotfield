# Auto-generated by Amane Settings (${DOTFIELD_THEME_ID})
[options]
background = ${DOTFIELD_BG_HEX}
scaling_mode = shrink
upscaling_method = linear
width = 1280
height = 800
loop_input = true
overlay = false
overlay_font = JetBrainsMono Nerd Font:13
overlay_text = [${imv_current_index}/${imv_file_count}] (${imv_width}x${imv_height} | ${imv_scale}%) ${imv_current_file}
overlay_text_color = ${DOTFIELD_FG_HEX}
overlay_text_alpha = ff
overlay_background_color = ${DOTFIELD_SURFACE_HEX}
overlay_background_alpha = dd

[binds]
q = quit
<Escape> = quit
f = fullscreen
i = overlay
d = overlay
<plus> = zoom 1
<equal> = zoom 1
<minus> = zoom -1
<BackSpace> = reset
x = zoom actual
c = center
j = pan 0 -50
k = pan 0 50
<Down> = pan 0 -50
<Up> = pan 0 50
h = prev
l = next
<Left> = prev
<Right> = next
<bracketleft> = prev
<bracketright> = next
gg = goto 1
<Shift+G> = goto -1
r = rotate by 90
<Shift+R> = rotate by -90
v = flip vertical
h = flip horizontal
s = scaling next
