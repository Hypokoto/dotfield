# Auto-generated by Amane Settings (${DOTFIELD_THEME_ID})
format = """
$username\
$hostname\
$directory\
$git_branch\
$git_state\
$git_status\
$rust\
$python\
$nodejs\
$golang\
$docker_context\
$cmd_duration\
$status\
$jobs\
$line_break\
$character"""

scan_timeout = 250
command_timeout = 500
palette = "dotfield"

[palettes.dotfield]
bg = "${DOTFIELD_BG}"
surface = "${DOTFIELD_SURFACE}"
overlay = "${DOTFIELD_OVERLAY}"
border = "${DOTFIELD_BORDER}"
fg = "${DOTFIELD_FG}"
fg_secondary = "${DOTFIELD_FG_SECONDARY}"
fg_muted = "${DOTFIELD_FG_MUTED}"
accent = "${DOTFIELD_ACCENT}"
success = "${DOTFIELD_SUCCESS}"
warning = "${DOTFIELD_WARNING}"
danger = "${DOTFIELD_DANGER}"
on_accent = "${DOTFIELD_ON_ACCENT}"
purple = "${DOTFIELD_C5}"

[character]
success_symbol = "[❯](bold accent)"
error_symbol = "[❯](bold danger)"
vimcmd_symbol = "[❮](bold accent)"
vimcmd_replace_symbol = "[❮](bold danger)"
vimcmd_replace_one_symbol = "[❮](bold danger)"
vimcmd_visual_symbol = "[❮](bold warning)"

[directory]
style = "bold accent"
truncation_length = 3
truncate_to_repo = true
read_only = " 󰌾"

[git_branch]
symbol = " "
style = "bold fg_secondary"
format = "[$symbol$branch]($style) "

[git_status]
style = "bold danger"
format = "([\\[$all_status$ahead_behind\\]]($style) )"
ignore_submodules = true

[package]
disabled = true

[git_state]
style = "bold warning"
format = "[$state( $progress_current/$progress_total)]($style) "

[rust]
symbol = "󱘗 "
style = "bold accent"
format = "[$symbol($version )]($style)"

[python]
symbol = "󰌠 "
style = "bold warning"
format = "[$symbol($version )]($style)"

[nodejs]
symbol = "󰌞 "
style = "bold success"
format = "[$symbol($version )]($style)"

[golang]
symbol = "󰟓 "
style = "bold purple"
format = "[$symbol($version )]($style)"

[docker_context]
symbol = "󰡨 "
style = "bold fg_muted"
format = "[$symbol$context]($style) "

[cmd_duration]
min_time = 1_000
style = "bold fg_muted"
format = "[$duration]($style) "

[status]
disabled = false
style = "bold danger"
symbol = "✘ "
format = "[$symbol$status]($style) "

[jobs]
symbol = "󰔚 "
style = "bold warning"
format = "[$symbol$number]($style) "

[line_break]
disabled = false
